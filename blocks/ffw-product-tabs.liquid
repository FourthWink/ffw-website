{% liquid
  assign tabs_id = block.id | replace: '_', '' | downcase
  assign tab1_content = block.settings.tab1_content

  if block.settings.use_product_description_for_tab1 and product.description != blank
    assign tab1_content = product.description
  endif
%}

{% style %}
  .ai-product-tabs-{{ tabs_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_mobile }}px 0;
  }

  .ai-product-tabs-container-{{ tabs_id }} {
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-product-tabs-layout-{{ tabs_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap_mobile }}px;
  }

  .ai-product-tabs-nav-{{ tabs_id }} {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: {{ block.settings.tab_spacing_mobile }}px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-product-tabs-button-{{ tabs_id }} {
    background: none;
    border: none;
    padding: {{ block.settings.tab_padding_mobile }}px 0;
    font-size: 10px;
    font-weight: 400;
    color: {{ block.settings.inactive_tab_color }};
    cursor: pointer;
    position: relative;
    transition: color 0.3s ease, font-weight 0.3s ease;
    white-space: nowrap;
  }

  .ai-product-tabs-button-{{ tabs_id }}.active {
    color: {{ block.settings.active_tab_color }};
    font-weight: 700;
  }

  .ai-product-tabs-button-{{ tabs_id }}::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: {{ block.settings.active_tab_color }};
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-product-tabs-button-{{ tabs_id }}.active::after {
    opacity: 1;
  }

  .ai-product-tabs-content-{{ tabs_id }} {
    display: none;
    text-align: center;
    font-size: 9px;
    line-height: {{ block.settings.content_line_height }};
    color: {{ block.settings.content_color }};
  }

  .ai-product-tabs-content-{{ tabs_id }}.active {
    display: block;
  }

  @media screen and (min-width: 750px) {
    .ai-product-tabs-{{ tabs_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 0;
    }

    .ai-product-tabs-layout-{{ tabs_id }} {
      flex-direction: row;
      gap: {{ block.settings.content_gap_desktop }}px;
      align-items: flex-start;
    }

    .ai-product-tabs-nav-{{ tabs_id }} {
      flex-direction: column;
      justify-content: flex-start;
      gap: {{ block.settings.tab_spacing_desktop }}px;
      border-bottom: none;
      min-width: {{ block.settings.tab_column_width }}px;
    }

    .ai-product-tabs-button-{{ tabs_id }} {
      text-align: left;
      padding: {{ block.settings.tab_padding_desktop }}px 0;
      font-size: 10px;
    }

    .ai-product-tabs-button-{{ tabs_id }}::after {
      display: none;
    }

    .ai-product-tabs-content-{{ tabs_id }} {
      flex: 1;
      text-align: left;
      font-size: 9px;
    }
  }
{% endstyle %}

<div
  id="ffw-product-tabs-{{ tabs_id }}"
  class="ai-product-tabs-{{ tabs_id }} ffw-product-tabs"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-tabs-container-{{ tabs_id }}">
    <div class="ai-product-tabs-layout-{{ tabs_id }}">
      <nav class="ai-product-tabs-nav-{{ tabs_id }}" role="tablist">
        <button
          type="button"
          class="ai-product-tabs-button-{{ tabs_id }} active"
          data-ffw-tab-button
          data-tab="tab1"
          role="tab"
          aria-selected="true"
          aria-controls="content-tab1-{{ tabs_id }}"
        >
          {{ block.settings.tab1_title }}
        </button>
        <button
          type="button"
          class="ai-product-tabs-button-{{ tabs_id }}"
          data-ffw-tab-button
          data-tab="tab2"
          role="tab"
          aria-selected="false"
          aria-controls="content-tab2-{{ tabs_id }}"
        >
          {{ block.settings.tab2_title }}
        </button>
        <button
          type="button"
          class="ai-product-tabs-button-{{ tabs_id }}"
          data-ffw-tab-button
          data-tab="tab3"
          role="tab"
          aria-selected="false"
          aria-controls="content-tab3-{{ tabs_id }}"
        >
          {{ block.settings.tab3_title }}
        </button>
      </nav>

      <div class="ai-product-tabs-panels-{{ tabs_id }}">
        <div
          id="content-tab1-{{ tabs_id }}"
          class="ai-product-tabs-content-{{ tabs_id }} active"
          data-ffw-tab-content
          data-tab="tab1"
          role="tabpanel"
        >
          {{ tab1_content }}
        </div>
        <div
          id="content-tab2-{{ tabs_id }}"
          class="ai-product-tabs-content-{{ tabs_id }}"
          data-ffw-tab-content
          data-tab="tab2"
          role="tabpanel"
        >
          {{ block.settings.tab2_content }}
        </div>
        <div
          id="content-tab3-{{ tabs_id }}"
          class="ai-product-tabs-content-{{ tabs_id }}"
          data-ffw-tab-content
          data-tab="tab3"
          role="tabpanel"
        >
          {{ block.settings.tab3_content }}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var root = document.getElementById('ffw-product-tabs-{{ tabs_id }}');
    if (!root || root.dataset.ffwTabsBound === 'true') return;

    root.dataset.ffwTabsBound = 'true';

    root.querySelectorAll('[data-ffw-tab-button]').forEach(function(button) {
      button.addEventListener('click', function() {
        var targetTab = button.getAttribute('data-tab');

        root.querySelectorAll('[data-ffw-tab-button]').forEach(function(tabButton) {
          var isActive = tabButton.getAttribute('data-tab') === targetTab;
          tabButton.classList.toggle('active', isActive);
          tabButton.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        root.querySelectorAll('[data-ffw-tab-content]').forEach(function(content) {
          content.classList.toggle('active', content.getAttribute('data-tab') === targetTab);
        });
      });
    });
  })();
</script>

