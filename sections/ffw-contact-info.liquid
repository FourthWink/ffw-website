<section class="ffw-contact-info">
  <div class="ffw-contact-info__rows" aria-label="Contact email addresses">
    <a class="ffw-contact-info__card" href="mailto:hello@fourthwink.com" aria-label="Email Fourth Wink general inquiries">
      <article class="ffw-contact-info__row">
        <h2>General Inquiries</h2>
        <span class="ffw-contact-info__email">hello@fourthwink.com</span>
        <p>For general questions, brand inquiries, and anything you would like to share with Fourth Wink.</p>
      </article>
    </a>

    <a class="ffw-contact-info__card" href="mailto:support@fourthwink.com" aria-label="Email Fourth Wink customer care and orders">
      <article class="ffw-contact-info__row">
        <h2>Customer Care &amp; Orders</h2>
        <span class="ffw-contact-info__email">support@fourthwink.com</span>
        <p>For order updates, payment questions, shipping, returns, exchanges, and customer support.</p>
      </article>
    </a>

    <a class="ffw-contact-info__card" href="mailto:pr@fourthwink.com" aria-label="Email Fourth Wink press and collaborations">
      <article class="ffw-contact-info__row">
        <h2>Press &amp; Collaborations</h2>
        <span class="ffw-contact-info__email">pr@fourthwink.com</span>
        <p>For media requests, editorials, stylists, collaborations, and PR.</p>
      </article>
    </a>

    <a class="ffw-contact-info__card" href="mailto:dreams@fourthwink.com" aria-label="Email Fourth Wink dreams and studio">
      <article class="ffw-contact-info__row">
        <h2>Dreams / Studio</h2>
        <span class="ffw-contact-info__email">dreams@fourthwink.com</span>
        <p>For creative requests, styling, shoots, production, and brand-world inquiries.</p>
      </article>
    </a>
  </div>

  <div class="ffw-contact-location" aria-label="Fourth Wink location and customer care">
    <p class="ffw-contact-location__place">Based in Cairo, Egypt</p>
    <p>For orders and customer care, contact us at</p>
    <div class="ffw-contact-location__links">
      <a href="mailto:support@fourthwink.com">support@fourthwink.com</a>
      <a href="tel:+201222242132">+20 1222242132</a>
    </div>
  </div>

  <img src="{{ 'Clouds.png' | asset_url }}" alt="Clouds" class="ffw-about-body-image ffw-contact-info__clouds" loading="lazy">
</section>

{% stylesheet %}
  .ffw-contact-info {
    width: 100%;
    padding: clamp(10px, 2vw, 24px) 0 0;
    background: #ffffff;
  }

  .ffw-contact-info__rows {
    width: min(100%, 1040px);
    max-width: calc(100vw - 40px);
    margin: 0 auto;
    display: grid;
    gap: clamp(18px, 3vw, 34px);
  }

  .ffw-contact-info__card {
    display: block;
    color: inherit !important;
    text-decoration: none;
    background: #ffffff;
    border-radius: var(--style-border-radius-buttons-primary);
    box-shadow:
      inset 0 0 14px rgb(var(--color-foreground-rgb) / 0.075),
      0 8px 22px rgb(var(--color-foreground-rgb) / 0.035);
    transition: box-shadow 0.25s ease;
  }

  .ffw-contact-info__card:hover,
  .ffw-contact-info__card:focus-visible {
    box-shadow:
      inset 0 0 16px rgb(var(--color-foreground-rgb) / 0.1),
      0 8px 24px rgb(var(--color-foreground-rgb) / 0.045);
  }

  .ffw-contact-info__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: clamp(28px, 4vw, 44px) 20px;
    text-align: center;
  }

  .ffw-contact-info__row h2,
  .ffw-contact-info__row p,
  .ffw-contact-info__email {
    margin: 0;
    font-size: 10px;
    line-height: 1.7;
    color: #444;
  }

  .ffw-contact-info__row h2 {
    font-weight: 700;
  }

  .ffw-contact-info__email {
    display: inline-block;
    min-width: 190px;
    font-weight: 400;
    color: #666666 !important;
    text-align: center;
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 3px;
    transition: color 0.25s ease, font-weight 0.25s ease;
  }

  .ffw-contact-info__card:hover .ffw-contact-info__email,
  .ffw-contact-info__card:focus-visible .ffw-contact-info__email {
    color: #000000 !important;
    font-weight: 700;
  }

  .ffw-contact-location {
    width: min(100%, 1040px);
    max-width: calc(100vw - 40px);
    margin: clamp(28px, 4vw, 52px) auto clamp(64px, 7vw, 96px);
    color: #444444;
    text-align: center;
  }

  .ffw-contact-location p {
    margin: 0;
    font-size: 10px;
    line-height: 1.7;
  }

  .ffw-contact-location__place {
    margin-bottom: 12px !important;
    font-weight: 700;
  }

  .ffw-contact-location__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
  }

  .ffw-contact-location__links a {
    color: #666666 !important;
    font-size: 10px;
    font-weight: 400;
    line-height: 1.7;
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 3px;
    transition: color 0.25s ease, font-weight 0.25s ease;
  }

  .ffw-contact-location__links a:hover,
  .ffw-contact-location__links a:focus-visible {
    color: #000000 !important;
    font-weight: 700;
  }

  .ffw-contact-info__clouds {
    --ffw-contact-cloud-shift: clamp(28px, 5vw, 72px);
    width: 100vw;
    max-width: 100%;
    display: block;
    margin: clamp(8px, 2vw, 24px) 0 0;
    position: relative;
    z-index: 5;
    transform: translateY(calc(-1 * var(--ffw-contact-cloud-shift)));
    margin-bottom: calc(-1 * var(--ffw-contact-cloud-shift));
  }

  @media screen and (max-width: 749px) {
    .ffw-contact-info {
      padding-top: 8px;
    }

    .ffw-contact-info__rows {
      max-width: calc(100vw - 32px);
    }

    .ffw-contact-info__row {
      padding: 30px 20px;
    }

    .ffw-contact-location {
      max-width: calc(100vw - 32px);
      margin: 30px auto 62px;
    }

    .ffw-contact-info__clouds {
      --ffw-contact-cloud-shift: 48px;
      margin-top: 0;
    }
  }
{% endstylesheet %}

