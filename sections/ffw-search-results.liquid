<style>
  body:has(main[data-template="search"]),
  html:has(main[data-template="search"]) {
    height: auto !important;
    overflow-y: auto !important;
  }

  body:has(main[data-template="search"]) #MainContent {
    position: relative !important;
    width: 100% !important;
    min-height: 100vh !important;
    height: auto !important;
    padding-top: var(--header-height, 80px) !important;
    overflow: visible !important;
  }

  body:has(main[data-template="search"]) .header-section,
  body:has(main[data-template="search"]) #header-group {
    position: fixed !important;
    top: 0 !important;
    right: 0 !important;
    left: 0 !important;
    z-index: 900 !important;
    width: 100% !important;
  }

  body:has(main[data-template="search"]) header-component .header {
    background-color: var(--color-background, #fff) !important;
  }

  body:has(main[data-template="search"]) .search-page__header {
    padding-inline: 60px;
  }

  body:has(main[data-template="search"]) search-page-input-component {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto 30px;
  }

  body:has(main[data-template="search"]) .search-page-input {
    width: 100%;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid #e0e0e0;
    border-radius: 0;
    background: transparent;
    color: #333;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 10px;
    font-weight: 400;
    outline: none;
  }

  body:has(main[data-template="search"]) search-page-input-component .search__icon,
  body:has(main[data-template="search"]) search-page-input-component .search__reset-button,
  body:has(main[data-template="search"]) .search-results__no-results {
    display: none;
  }

  .ffw-search-results-section {
    width: 100%;
    min-height: 70vh;
    padding: 0 60px 40px;
    box-sizing: border-box;
  }

  .ffw-search-results-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: 1400px;
    margin: 0 auto 100px;
  }

  .ffw-search-results-grid .ffw-shop-product {
    position: relative;
    display: flex;
    aspect-ratio: 0.7;
    padding: 60px 20px 40px;
    overflow: hidden;
    box-sizing: border-box;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    border-radius: 100px;
    background-color: #f8f8f8;
    color: inherit;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ffw-search-results-grid .ffw-shop-product:hover {
    opacity: 0.92;
  }

  .ffw-search-results-grid .ffw-shop-product-image {
    width: 100%;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 15px;
  }

  .ffw-search-results-grid .ffw-shop-product-image-stack {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template: "media" minmax(0, 1fr) / minmax(0, 1fr);
    align-items: center;
    justify-items: center;
    padding-top: 10px;
  }

  .ffw-search-results-grid .ffw-shop-product-image-stack img,
  .ffw-search-results-grid .ffw-shop-product-image > img {
    grid-area: media;
    width: auto;
    max-width: 100%;
    max-height: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  .ffw-search-results-grid .ffw-shop-product-image-primary,
  .ffw-search-results-grid .ffw-shop-product-image-secondary {
    transition: opacity 0.3s ease;
  }

  .ffw-search-results-grid .ffw-shop-product-image-secondary {
    opacity: 0;
    pointer-events: none;
  }

  .ffw-search-results-grid .ffw-shop-product-info {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ffw-search-results-grid .ffw-shop-text-group {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    transform: translateY(12px);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ffw-search-results-grid .ffw-shop-product:hover .ffw-shop-text-group {
    transform: translateY(-16px);
  }

  .ffw-search-results-grid .ffw-shop-product-name {
    margin: 0;
    color: #333;
    font-size: 10px;
    font-weight: 400;
  }

  .ffw-search-results-grid .ffw-shop-product-price {
    margin: 0;
    color: #555;
    font-size: 9px;
  }

  .ffw-search-results-grid .ffw-price-compare {
    margin-right: 4px;
    color: #bbb;
    text-decoration: line-through;
  }

  .ffw-search-results-grid .ffw-shop-product-icon {
    position: absolute;
    bottom: 4px;
    left: 50%;
    padding: 10px;
    border: 0;
    background: transparent;
    cursor: pointer;
    line-height: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(30px);
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ffw-search-results-grid .ffw-shop-product:hover .ffw-shop-product-icon {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .ffw-search-results-grid .ffw-shop-product-icon img {
    width: 14px;
    height: auto;
    opacity: 0.6;
  }

  .ffw-search-empty {
    padding: 100px 20px;
    color: #666;
    font-size: 10px;
    text-align: center;
  }

  @media screen and (min-width: 750px) and (hover: hover) and (pointer: fine) {
    .ffw-search-results-grid .ffw-shop-product:hover .ffw-shop-product-image--has-hover .ffw-shop-product-image-primary {
      opacity: 0;
    }

    .ffw-search-results-grid .ffw-shop-product:hover .ffw-shop-product-image--has-hover .ffw-shop-product-image-secondary {
      opacity: 1;
    }
  }

  @media screen and (max-width: 1439px) and (min-width: 1024px) {
    .ffw-search-results-grid {
      gap: 20px;
    }

    .ffw-search-results-section {
      padding-inline: 40px;
    }
  }

  @media screen and (max-width: 1023px) {
    body:has(main[data-template="search"]) .search-page__header,
    .ffw-search-results-section {
      padding-inline: 30px;
    }

    .ffw-search-results-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ffw-search-results-grid .ffw-shop-product-info {
      height: 75px;
    }

    .ffw-search-results-grid .ffw-shop-text-group {
      margin-bottom: 0;
      transform: translateY(-12px);
    }

    .ffw-search-results-grid .ffw-shop-product-icon {
      bottom: 2px;
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
  }

  @media screen and (max-width: 767px) {
    body:has(main[data-template="search"]) .search-page__header,
    .ffw-search-results-section {
      padding-inline: 20px;
    }

    .ffw-search-results-grid {
      gap: 15px;
    }
  }

  @media screen and (max-width: 575px) {
    body:has(main[data-template="search"]) .search-page__header,
    .ffw-search-results-section {
      padding-inline: 15px;
    }

    .ffw-search-results-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ffw-search-results-grid .ffw-shop-product {
      padding: 40px 12px 25px;
      border-radius: 80px;
    }
  }
</style>

<div class="ffw-search-results-section">
  {% paginate search.results by 24 %}
    {%- assign product_count = 0 -%}

    <div class="ffw-search-results-grid">
      {%- for result in search.results -%}
        {%- assign product_count = product_count | plus: 1 -%}
        {%- render 'ffw-search-product-card', product: result -%}
      {%- endfor -%}
    </div>

    {%- if product_count == 0 -%}
      <p class="ffw-search-empty">No products found.</p>
    {%- endif -%}

    {% render 'pagination-controls', paginate: paginate %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "FFW search results",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [],
  "presets": []
}
{% endschema %}
