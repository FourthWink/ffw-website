
<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<style>
  /* ==========================================================
     SEARCH PAGE: FORCE NORMAL DOCUMENT FLOW
  ========================================================== */
  body:has(main[data-template="search"]),
  html:has(main[data-template="search"]) {
    overflow-y: auto !important;
    height: auto !important;
    position: static !important;
  }

  body:has(main[data-template="search"]) #MainContent {
    position: relative !important;
    height: auto !important;
    min-height: 100vh !important;
    overflow: visible !important;
    width: 100% !important;
    top: auto !important;
    left: auto !important;
  }

  body:has(main[data-template="search"]) .collection-wrapper,
  body:has(main[data-template="search"]) .product-grid-container,
  body:has(main[data-template="search"]) results-list {
    position: relative !important;
    overflow: visible !important;
    height: auto !important;
  }

  body:has(main[data-template="search"]) ul.product-grid,
  body:has(main[data-template="search"]) ol.product-grid,
  body:has(main[data-template="search"]) .product-grid {
    display: grid !important;
    position: relative !important;
    overflow: visible !important;
  }

  body:has(main[data-template="search"]) .product-grid__item {
    position: relative !important;
    overflow: hidden !important;
  }

  /* ==========================================================
     DUPLICATE CARD FIX
  ========================================================== */
  body:has(main[data-template="search"]) .product-grid__item product-card ~ a,
  body:has(main[data-template="search"]) .product-grid__item product-card ~ div {
    display: none !important;
  }

  /* ==========================================================
     FIXED HEADER ON SEARCH PAGE
     Forces the header to stay fixed at the top while scrolling.
  ========================================================== */
  body:has(main[data-template="search"]) .header-section,
  body:has(main[data-template="search"]) #header-group {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 900 !important;
  }

  /* Solid background so content doesn't bleed through when scrolling */
  body:has(main[data-template="search"]) header-component .header {
    background-color: var(--color-background, #ffffff) !important;
  }

  /* Push MainContent down to account for the fixed header */
  body:has(main[data-template="search"]) #MainContent {
    padding-top: var(--header-height, 80px) !important;
  }

  body:has(main[data-template="search"]) .search-page__header {
    padding-inline: 60px;
  }

  body:has(main[data-template="search"]) search-page-input-component {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto 30px;
  }

  body:has(main[data-template="search"]) .search-page-input {
    width: 100%;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid #e0e0e0;
    border-radius: 0;
    background: transparent;
    color: #333;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 10px;
    font-weight: 400;
    outline: none;
  }

  body:has(main[data-template="search"]) search-page-input-component .search__icon,
  body:has(main[data-template="search"]) search-page-input-component .search__reset-button,
  body:has(main[data-template="search"]) .search-results__no-results {
    display: none;
  }

  .ffw-search-results-grid {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto 100px;
    padding-inline: 60px;
  }

  .ffw-search-results-grid .ffw-shop-product {
    position: relative;
    display: flex;
    aspect-ratio: 0.7;
    padding: 60px 20px 40px;
    overflow: hidden;
    box-sizing: border-box;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    border-radius: 100px;
    background-color: #f8f8f8;
    color: inherit;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ffw-search-results-grid .ffw-shop-product:hover {
    opacity: 0.92;
  }

  .ffw-search-results-grid .ffw-shop-product-image {
    width: 100%;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 15px;
  }

  .ffw-search-results-grid .ffw-shop-product-image-stack {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template: "media" minmax(0, 1fr) / minmax(0, 1fr);
    align-items: center;
    justify-items: center;
    padding-top: 10px;
  }

  .ffw-search-results-grid .ffw-shop-product-image-stack img,
  .ffw-search-results-grid .ffw-shop-product-image > img {
    grid-area: media;
    width: auto;
    max-width: 100%;
    max-height: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  .ffw-search-results-grid .ffw-shop-product-image-primary,
  .ffw-search-results-grid .ffw-shop-product-image-secondary {
    transition: opacity 0.3s ease;
  }

  .ffw-search-results-grid .ffw-shop-product-image-secondary {
    opacity: 0;
    pointer-events: none;
  }

  .ffw-search-results-grid .ffw-shop-product-info {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ffw-search-results-grid .ffw-shop-text-group {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    transform: translateY(12px);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ffw-search-results-grid .ffw-shop-product:hover .ffw-shop-text-group {
    transform: translateY(-16px);
  }

  .ffw-search-results-grid .ffw-shop-product-name {
    margin: 0;
    color: #333;
    font-size: 10px;
    font-weight: 400;
  }

  .ffw-search-results-grid .ffw-shop-product-price {
    margin: 0;
    color: #555;
    font-size: 9px;
  }

  .ffw-search-results-grid .ffw-price-compare {
    margin-right: 4px;
    color: #bbb;
    text-decoration: line-through;
  }

  .ffw-search-results-grid .ffw-shop-product-icon {
    position: absolute;
    bottom: 4px;
    left: 50%;
    padding: 10px;
    border: 0;
    background: transparent;
    cursor: pointer;
    line-height: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(30px);
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ffw-search-results-grid .ffw-shop-product:hover .ffw-shop-product-icon {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .ffw-search-results-grid .ffw-shop-product-icon img {
    width: 14px;
    height: auto;
    opacity: 0.6;
  }

  .ffw-search-empty {
    padding: 100px 20px;
    color: #666;
    font-size: 10px;
    text-align: center;
  }

  @media screen and (min-width: 750px) and (hover: hover) and (pointer: fine) {
    .ffw-search-results-grid .ffw-shop-product:hover .ffw-shop-product-image--has-hover .ffw-shop-product-image-primary {
      opacity: 0;
    }

    .ffw-search-results-grid .ffw-shop-product:hover .ffw-shop-product-image--has-hover .ffw-shop-product-image-secondary {
      opacity: 1;
    }
  }

  @media screen and (max-width: 1439px) and (min-width: 1024px) {
    .ffw-search-results-grid {
      gap: 20px;
      padding-inline: 40px;
    }
  }

  @media screen and (max-width: 1023px) {
    body:has(main[data-template="search"]) .search-page__header,
    .ffw-search-results-grid {
      padding-inline: 30px;
    }

    .ffw-search-results-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ffw-search-results-grid .ffw-shop-product-info {
      height: 75px;
    }

    .ffw-search-results-grid .ffw-shop-text-group {
      margin-bottom: 0;
      transform: translateY(-12px);
    }

    .ffw-search-results-grid .ffw-shop-product-icon {
      bottom: 2px;
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
  }

  @media screen and (max-width: 767px) {
    body:has(main[data-template="search"]) .search-page__header,
    .ffw-search-results-grid {
      padding-inline: 20px;
    }

    .ffw-search-results-grid {
      gap: 15px;
    }
  }

  @media screen and (max-width: 575px) {
    body:has(main[data-template="search"]) .search-page__header,
    .ffw-search-results-grid {
      padding-inline: 15px;
    }

    .ffw-search-results-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ffw-search-results-grid .ffw-shop-product {
      padding: 40px 12px 25px;
      border-radius: 80px;
    }
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<results-list
  class="section product-grid-container spacing-style color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div class="collection-wrapper grid gap-style">

    {% assign products_per_page = 24 %}
    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate search.results by products_per_page %}

      {% if search.terms == 'steven' %}
        <style>
          .search-no-results, .search__no-results, [data-no-results], .product-grid__no-results {
            display: none !important;
          }
        </style>
        <div style="text-align:center;padding:4rem 2rem;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;">
          <div style="font-size:10px;margin-bottom:1rem;">🕺</div>
          <h2 style="font-size:10px;margin-bottom:0.5rem;">Welcome Back Mr. Developer!</h2>
        </div>
        {% content_for 'block', type: 'filters', id: 'filters', results: search, results_size: search.results_count %}
        {% assign products = search.results | where: 'object_type', 'product' %}

      {% elsif search.performed and search.results_count > 0 %}
        {% assign products = search.results | where: 'object_type', 'product' %}

      {% else %}
        {% assign products = search.results | where: 'object_type', 'product' %}
      {% endif %}

      <div class="ffw-search-results-grid">
        {% for product in products %}
          {% render 'ffw-search-product-card', product: product %}
        {% endfor %}
      </div>

      {% if products.size == 0 %}
        <p class="ffw-search-empty">No products found.</p>
      {% endif %}

    {% endpaginate %}
  </div>
</results-list>

{% schema %}
{
  "name": "t:names.search_results",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_empty_state_collection_in_theme_settings"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        { "value": "grid", "label": "t:options.grid" },
        { "value": "organic", "label": "t:options.editorial" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" },
        { "value": "extra-large", "label": "t:options.extra_large" }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        { "value": "small", "label": "t:options.small" },
        { "value": "large", "label": "t:options.large" }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        { "value": "centered", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
