{% comment %}
  ffw-about.liquid — Fourth Wink
  Bulletproof Fixed-Container Scroll Snapping
{% endcomment %}

<style>
/* 1. Stop the main Shopify page from scrolling at all so it doesn't fight our snapper */
  html, body {
    overflow: hidden !important;
    height: 100% !important;
  }

  /* 2. Hide the floating center star and text on this page */
  .center-star-bg, .ffw-static-text { display: none !important; }
/* Remove header and footer divider lines on this page */
  #shopify-section-header .header__row,
  .shopify-section-group-footer-group, 
  footer {
    border: none !important;
    box-shadow: none !important;
  }
  /* 3. The Bulletproof Fullscreen Container */
  .ffw-snapper-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    z-index: 100; /* High enough to cover content, but sits under your header (which is 600) */
    background-color: #ffffff; /* Match your site background color */
    
    /* Hide scrollbars for an absolute clean, app-like look */
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .ffw-snapper-wrapper::-webkit-scrollbar {
    display: none;
  }

  .ffw-about-scroll-cue {
    position: fixed;
    left: 50%;
    bottom: max(48px, calc(env(safe-area-inset-bottom) + 36px));
    z-index: 110;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transform: translateX(-50%);
    transition: opacity 0.25s ease, visibility 0.25s ease;
    will-change: transform;
  }

  .ffw-about-scroll-cue.is-bouncing {
    animation: ffw-about-scroll-bounce 1.8s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .ffw-about-scroll-cue img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ffw-about-scroll-cue.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @keyframes ffw-about-scroll-bounce {
    0%, 12%, 100% { transform: translate(-50%, 0); }
    32% { transform: translate(-50%, -10px); }
    50% { transform: translate(-50%, 0); }
    65% { transform: translate(-50%, -5px); }
    78% { transform: translate(-50%, 0); }
    88% { transform: translate(-50%, -2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ffw-about-scroll-cue.is-bouncing {
      animation: none;
    }
  }

  /* 4. The Background Eye - locked perfectly to the center of the screen */
  .ffw-snapper-eye {
    position: fixed;
    top: 49.5dvh;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 150px;
    width:auto;
    z-index: 4;
    pointer-events: none;
  }

/* 5. The Snapping Blocks */
  .ffw-snap-block {
    width: 100%;
    height: 100dvh; 
    scroll-snap-align: start; 
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    
    /* UPDATE THESE PADDING VALUES: */
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 49vh; /* <--- This pushes the whole block of text down */
    box-sizing: border-box;
    position: relative;
    z-index: 2; 
  }
  
  /* 6. Typography */
  .ffw-about-vision-title,
  .ffw-about-subtitle {
    font-size: 11px;
    font-weight: 700;
    color: #000000;
    
    
    margin-bottom: 100px;
  }
  
/* 6. Typography - Maximum Specificity & Anti-Mobile-Scaling */
  div.ffw-snapper-wrapper div.ffw-snap-block div.ffw-about-vision-title,
  div.ffw-snapper-wrapper div.ffw-snap-block div.ffw-about-subtitle {
    font-size: 11px !important;
    font-weight: 700 !important;
    color: #000000 !important;
    margin-bottom: 100px !important;
    -webkit-text-size-adjust: 100% !important; /* Stops iOS from shrinking text */
    text-size-adjust: 100% !important;
  }
  
  div.ffw-snapper-wrapper div.ffw-snap-block p.ffw-about-text,
  div.ffw-snapper-wrapper div.ffw-snap-block .ffw-about-text {
    max-width: 700px !important; 
    font-size: 11px !important;
    line-height: 1.8 !important;
    color: #000000 !important;
    margin: 0 !important;
    -webkit-text-size-adjust: 100% !important; /* Stops iOS from shrinking text */
    text-size-adjust: 100% !important;
  }
 .ffw-about-body-image {
    width: 100vw;
    max-width: 100%;
    display: block;
    margin: 0;
    position: relative;
    z-index: 5;
  }
  /* Remove padding from the final block so the clouds touch the edges */
  .ffw-snap-block:last-child {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0; /* Ensures the clouds sit exactly where you want them */
    z-index: 6;
  }

  .ffw-snap-block:last-child .shopify-section-group-footer-group [class*="ai-luxury-footer-column-left-"],
  .ffw-snap-block:last-child footer [class*="ai-luxury-footer-column-left-"],
  .ffw-snap-block:last-child .shopify-section-group-footer-group [class*="ai-luxury-footer-links-"],
  .ffw-snap-block:last-child footer [class*="ai-luxury-footer-links-"],
  .ffw-snap-block:last-child .shopify-section-group-footer-group [class*="ai-luxury-footer-link-"],
  .ffw-snap-block:last-child footer [class*="ai-luxury-footer-link-"] {
    text-align: left !important;
  }

  @media screen and (min-width: 769px) and (max-width: 1279px) {
    .ffw-snapper-wrapper {
      scroll-snap-type: y proximity;
    }

    .ffw-snap-block:last-child {
      scroll-snap-align: none;
      scroll-snap-stop: normal;
    }
  }

  @media screen and (max-width: 768px) {
    .ffw-snapper-eye { height: 150px; }
    .ffw-about-text, .ffw-about-subtitle, .ffw-about-vision-title { font-size: 11px; }
    .ffw-snap-block { padding-top: calc(49dvh); }
    .ffw-about-scroll-cue {
      bottom: max(14px, calc(env(safe-area-inset-bottom) + 10px));
    }
  }
</style>

<div class="ffw-snapper-wrapper">
  <img src="{{ 'about.png' | asset_url }}" alt="Glass Eye" class="ffw-snapper-eye">
  <button class="ffw-about-scroll-cue" type="button" aria-label="Scroll to the next section">
    <img src="{{ 'ffw-scroll-arrow.svg' | asset_url }}" alt="" width="56" height="56">
  </button>

  <div class="ffw-snap-block">
    <div class="ffw-about-vision-title">THE VISION</div>
    <p class="ffw-about-text">
      <b>FOURTH WINK</b> lives somewhere between reality and dream. Built around the invitation to dream a bit, the brand is a reminder to drift, imagine, and look at things differently, even for a moment. To dream a bit is to look at something familiar and let it become strange for a second. Inspired by surrealism, dream logic, and the quiet poetry of everyday life, <b>FOURTH WINK</b> turns the ordinary into pieces and objects that feel playful, intimate, and slightly unreal.
    </p>
  </div>

  <div class="ffw-snap-block">
    <div class="ffw-about-subtitle">THE MEANING</div>
    <p class="ffw-about-text">
      Inspired by the four stages of sleep, <b>FOURTH WINK</b> begins with the idea of drifting away from the waking world. Stage one is drifting, stage two is separation, stage three is depth, and the Fourth Wink is the final threshold, where logic softens, the subconscious takes over, and the hidden self begins to appear. A wink is also a signal, a secret, and a small flirtation with the absurd.
    </p>
  </div>

  <div class="ffw-snap-block">
    <div class="ffw-about-subtitle">THE EYE</div>
    <p class="ffw-about-text">
      The eye is the symbol of <b>FOURTH WINK</b>. Chosen because the eyes are often seen as the gateway to the soul, it also becomes our gateway to the subconscious, dreams, hidden thoughts, and the parts of ourselves that do not always appear in the waking world. Fractured into four parts, the eye reflects the four stages behind the name, while its center can shift with each collection.
    </p>
  </div>

  <div class="ffw-snap-block">
    <div class="ffw-about-subtitle">THE PIECES</div>
    <p class="ffw-about-text">
      Every <b>FOURTH WINK</b> piece begins with an idea. Whether it becomes a garment, an accessory, an object, or something in between, each piece is made to carry a feeling that is strange, precise, and slightly surreal. We use premium quality materials and focus on every small detail, from shape and construction to finishing, craftsmanship, and final feel.
    </p>
  </div>


  <div class="ffw-snap-block">
    <img src="{{ 'Clouds.png' | asset_url }}" alt="Body" class="ffw-about-body-image">
  </div>

</div>
<script>
  (function() {
  function initFfwAboutPage() {
    var footerGroup = document.querySelector('.shopify-section-group-footer-group') || document.querySelector('footer');
    var snapper = document.querySelector('.ffw-snapper-wrapper');
    var scrollCue = document.querySelector('.ffw-about-scroll-cue');
    var snapBlocks = document.querySelectorAll('.ffw-snap-block');
    var finalBlock = snapBlocks[snapBlocks.length - 1];

    if (snapper && scrollCue && snapBlocks.length > 1) {
      window.setTimeout(function() {
        scrollCue.classList.remove('is-bouncing');
        void scrollCue.offsetWidth;
        scrollCue.classList.add('is-bouncing');
      }, 150);

      if (!scrollCue.dataset.ffwAboutCueBound) {
        scrollCue.dataset.ffwAboutCueBound = 'true';
        scrollCue.addEventListener('click', function() {
          snapBlocks[1].scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      if (!snapper.dataset.ffwAboutScrollBound) {
        snapper.dataset.ffwAboutScrollBound = 'true';
        snapper.addEventListener('scroll', function() {
          scrollCue.classList.toggle('is-hidden', snapper.scrollTop > 20);
        }, { passive: true });
      }
    }
    
    if (finalBlock && footerGroup) {
      // 1. Let the footer flow naturally
      footerGroup.style.position = 'relative';
      footerGroup.style.bottom = 'auto';
      footerGroup.style.width = '100%';
      footerGroup.style.zIndex = '10';
      footerGroup.style.marginTop = '0';
      footerGroup.style.marginBottom = '0'; // Strip JS-injected bottom margin
      
      // 2. Wrap perfectly around the content (no forced 100vh minimum)
      finalBlock.style.height = 'auto';
      finalBlock.style.minHeight = 'auto'; // Changed from 100dvh to kill the extra empty space
      finalBlock.style.paddingBottom = '0'; 
      
      // 3. Move the footer inside
      finalBlock.appendChild(footerGroup);
    }
  }

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', initFfwAboutPage);
  } else {
    initFfwAboutPage();
  }

  window.addEventListener('pageshow', initFfwAboutPage);
  document.addEventListener('shopify:section:load', initFfwAboutPage);
  })();
</script>
{% schema %}
{
  "name": "FFW About",
  "tag": "section",
  "class": "ffw-about-wrapper",
  "settings": [],
  "presets": [{ "name": "FFW About" }]
}
{% endschema %}
