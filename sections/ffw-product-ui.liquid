{%- if template.name == 'product' -%}

{% comment %}
  Fourth Wink product UI helpers.

  This section renders product-page overlays that sit outside the native Shopify
  product-information section: the fixed wishlist sparkle and the mobile Add to
  Cart bar. The desktop floating ATC is rendered by snippets/ffw-floating-atc.liquid
  through templates/product.json, while sections/custom-liquid.liquid still owns
  the delegated cart handler.
{% endcomment %}

{%- liquid
  assign product_title     = product.title | escape
  assign product_price_fmt = product.selected_or_first_available_variant.price | money
  assign product_price_raw = product.selected_or_first_available_variant.price | divided_by: 100.0
  assign product_image     = product.featured_media | image_url: width: 300
  assign product_url       = product.url
  assign variant_id        = product.selected_or_first_available_variant.id
  assign size_names        = product.metafields.shopify.size.value | map: 'label' | join: ', '
  assign color_names       = product.metafields.shopify.color-pattern.value | map: 'label' | join: ', '

  for option in product.options_with_values
    assign option_handle = option.name | handleize
    if size_names == blank and option_handle contains 'size'
      assign size_names = option.values | join: ', '
    endif
    if color_names == blank and option_handle contains 'color'
      assign color_names = option.values | join: ', '
    endif
  endfor
-%}

<button
  id="ffwinks-product-sparkle"
  class="ffw-wishlist-btn"
  data-ffwinks-sparkle
  data-ffw-product-page-sparkle
  type="button"
  aria-label="Add {{ product_title }} to wishlist"
  data-variant-id="{{ variant_id }}"
  data-title="{{ product_title }}"
  data-price="{{ product_price_raw }}"
  data-price-formatted="{{ product_price_fmt }}"
  data-image="{{ product_image }}"
  data-url="{{ product_url }}"
  data-available-sizes="{{ size_names | escape }}"
  data-available-colors="{{ color_names | escape }}"
  data-svg-empty="{{ 'sparkle.svg' | asset_url }}"
  data-svg-filled="{{ 'sparkle-icon.svg' | asset_url }}"
>
  <img src="{{ 'sparkle.svg' | asset_url }}" alt="Wishlist" class="ffwinks-sparkle-img">
</button>

<div id="ffwinks-mobile-atc">
  <button type="button" class="floating-atc-btn ffwinks-mobile-atc-btn">Add to cart</button>
</div>

<style>
  /* Wishlist sparkle — fixed top-right, same size as header sparkle (--icon-size-md = 1.375rem) */
  #ffwinks-product-sparkle {
    position: fixed;
    top: calc(var(--header-group-height, 72px) + 20px);
    right: 54px;
    z-index: 9000;
    background: none !important;
    border: none !important;
    box-shadow: none !important;
    cursor: pointer;
    padding: 6px;
    line-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }
  #ffwinks-product-sparkle:hover {
    transform: none;
    opacity: 0.8;
  }
  /* Match header icon size exactly */
  .ffwinks-sparkle-img {
    width: auto;
    height: 15px;
  }
  #ffwinks-product-sparkle.ffwinks-sparkle--pop {
    animation: sparklePop 0.3s ease;
  }
  @keyframes sparklePop {
    0%   { transform: scale(1); }
    50%  { transform: scale(1.5); }
    100% { transform: scale(1); }
  }

  /* Mobile ATC bar — hidden on desktop */
  @media (min-width: 990px) {
    #ffwinks-product-sparkle {
      top: 160px;
      right: 113px;
    }
  }

  #ffwinks-mobile-atc { display: none; }

  @media (max-width: 749px) {
    /* Hide sparkle on mobile */
    #ffwinks-product-sparkle {
      display: none !important;
    }

    /* Hide the floating star on mobile */
    .floating-atc { display: none !important; }

    /* Show mobile bar */
    #ffwinks-mobile-atc {
      display: flex !important;
      position: fixed;
      bottom: 8px; left: 0; right: 0;
      z-index: 999999;
      padding: 12px 16px;
      padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      background: #fff;
      box-sizing: border-box;
      transition: opacity 0.2s, visibility 0.2s;
    }

    #ffwinks-mobile-atc.ffw-mobile-atc--footer-locked {
      position: absolute;
      top: var(--ffw-mobile-atc-footer-top);
      bottom: auto;
      transform: none;
    }

    /* The Smooth Top Fade (Fog) */
    #ffwinks-mobile-atc::before {
      content: '';
      position: absolute;
      bottom: 100%; /* Sits exactly on top of the solid white ATC bar */
      left: 0;
      width: 100%;
      height: 52px;
      background: linear-gradient(to top, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 100%);
      pointer-events: none; 
    }

    #ffwinks-mobile-atc .ffwinks-mobile-atc-btn {
      width: 100%;
      padding: 16px;
      background: transparent !important;
      color: #000 !important;
      border: none !important;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 700 !important;
      
      cursor: pointer;
      transition: opacity 0.15s;
    }
    .ffwinks-mobile-atc-btn:active { opacity: 0.7; }
    body.cart-overlay-open #ffwinks-mobile-atc,
    body.ffwinks-adding #ffwinks-mobile-atc {
      opacity: 0; visibility: hidden; pointer-events: none;
    }
    /* Push product content above the bar without adding empty space after the footer. */
    .product-information.section {
      padding-bottom: calc(92px + env(safe-area-inset-bottom, 0px)) !important;
    }
  }
</style>

<script>
// Keep the mobile ATC bar from covering the footer while preserving its fixed behavior.
(function () {
  function initMobileAtcFooterGuard() {
    var mobileAtc = document.getElementById('ffwinks-mobile-atc');
    if (!mobileAtc) return;

    var mq = window.matchMedia('(max-width: 749px)');
    var footer = null;
    var frame = null;
    var locked = false;
    var fixedBottomY = null;

    function getFooter() {
      if (footer && document.documentElement.contains(footer)) return footer;
      footer = document.querySelector('.shopify-section-group-footer-group') || document.querySelector('footer');
      return footer;
    }

    function getFixedBottomY() {
      if (!locked || fixedBottomY === null) {
        var bottom = parseFloat(window.getComputedStyle(mobileAtc).bottom);
        if (!Number.isFinite(bottom)) bottom = 0;
        fixedBottomY = window.innerHeight - bottom;
      }

      return fixedBottomY;
    }

    function getScrollElement() {
      if (document.body && document.body.scrollHeight > document.body.clientHeight + 1) return document.body;
      return document.scrollingElement || document.documentElement;
    }

    function getScrollY() {
      var scrollElement = getScrollElement();
      return scrollElement ? scrollElement.scrollTop : window.scrollY;
    }

    function getDocumentTop(element) {
      return element.getBoundingClientRect().top + getScrollY();
    }

    function unlock() {
      locked = false;
      mobileAtc.classList.remove('ffw-mobile-atc--footer-locked');
      mobileAtc.style.removeProperty('--ffw-mobile-atc-footer-top');
    }

    function update() {
      frame = null;

      if (!mq.matches) {
        unlock();
        return;
      }

      var footerEl = getFooter();
      if (!footerEl) {
        unlock();
        return;
      }

      var scrollY = getScrollY();
      var footerTop = getDocumentTop(footerEl);
      var lockScrollY = footerTop - getFixedBottomY();
      var unlockScrollY = lockScrollY - 12;

      if (locked ? scrollY < unlockScrollY : scrollY < lockScrollY) {
        unlock();
        return;
      }

      locked = true;
      mobileAtc.classList.add('ffw-mobile-atc--footer-locked');
      mobileAtc.style.setProperty('--ffw-mobile-atc-footer-top', Math.round(footerTop - mobileAtc.getBoundingClientRect().height) + 'px');
    }

    function queueUpdate() {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    }

    window.addEventListener('scroll', queueUpdate, { passive: true });
    document.addEventListener('scroll', queueUpdate, { capture: true, passive: true });
    document.documentElement.addEventListener('scroll', queueUpdate, { passive: true });
    document.body.addEventListener('scroll', queueUpdate, { passive: true });
    window.addEventListener('resize', function() {
      fixedBottomY = null;
      queueUpdate();
    });
    window.addEventListener('load', queueUpdate);
    if (mq.addEventListener) mq.addEventListener('change', queueUpdate);

    queueUpdate();
    setTimeout(queueUpdate, 250);
    setTimeout(queueUpdate, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileAtcFooterGuard);
  } else {
    initMobileAtcFooterGuard();
  }
})();

// Deselect all variant options on first load (custom AI variant picker)
(function () {
  // Only deselect if the user didn't arrive with a ?variant= param
  if (window.location.search.indexOf('variant=') !== -1) return;

  function deselect() {
    document.querySelectorAll('[class*="ai-variant-picker-"]').forEach(function(picker) {
      var hasIncompleteSelection = false;

      picker.querySelectorAll('[class*="ai-variant-picker__option"]').forEach(function(optionGroup) {
        var buttons = optionGroup.querySelectorAll('[class*="ai-variant-picker__value"]');

        if (buttons.length === 1) {
          buttons[0].classList.add('selected');
          return;
        }

        buttons.forEach(function(btn) {
          btn.classList.remove('selected');
        });
        hasIncompleteSelection = true;
      });

      if (!hasIncompleteSelection) return;

      var sel = picker.querySelector('select[name="id"]');
      if (sel) {
        sel.value = '';
        sel.querySelectorAll('option[selected]').forEach(function(opt) {
          opt.removeAttribute('selected');
        });
      }
    });
  }

  // Run at multiple points to beat any late JS hydration
  deselect();
  document.addEventListener('DOMContentLoaded', deselect);
  setTimeout(deselect, 100);
  setTimeout(deselect, 400);
})();
</script>

{%- endif -%}

{% schema %}
{
  "name": "Product UI",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [{ "name": "Product UI" }]
}
{% endschema %}
