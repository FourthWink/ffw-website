<section class="ffw-contact-location" aria-label="Fourth Wink location and customer care">
  <p class="ffw-contact-location__place">Based in Cairo, Egypt</p>
  <p>For orders and customer care, contact us at</p>
  <div class="ffw-contact-location__links">
    <a href="mailto:support@fourthwink.com">support@fourthwink.com</a>
    <a href="tel:+201222242132">+20 1222242132</a>
  </div>
</section>

{% stylesheet %}
  .ffw-contact-location {
    width: min(100%, 1040px);
    max-width: calc(100vw - 40px);
    margin: 0 auto;
    padding: clamp(18px, 3vw, 34px) 0 clamp(24px, 4vw, 44px);
    color: #444444;
    text-align: center;
  }

  .ffw-contact-location p {
    margin: 0;
    font-size: 10px;
    line-height: 1.7;
  }

  .ffw-contact-location__place {
    margin-bottom: 12px !important;
    font-weight: 700;
  }

  .ffw-contact-location__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
  }

  .ffw-contact-location__links a {
    color: #666666 !important;
    font-size: 10px;
    font-weight: 400;
    line-height: 1.7;
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 3px;
    transition: color 0.25s ease, font-weight 0.25s ease;
  }

  .ffw-contact-location__links a:hover,
  .ffw-contact-location__links a:focus-visible {
    color: #000000 !important;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .ffw-contact-location {
      max-width: calc(100vw - 32px);
      padding: 14px 0 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FFW Contact Location",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "FFW Contact Location"
    }
  ]
}
{% endschema %}
