{% comment %}
  Fourth Wink shared wishlist page.

  The page body is rendered from snippets/ffwinks-js.liquid so shared wishlist
  links and the fullscreen wishlist overlay use the same product-loading logic.
{% endcomment %}

<section class="ffw-shared-wishlist ffwinks-fullscreen ffwinks-fullscreen--open" id="ffw-shared-wishlist-page" aria-labelledby="ffw-shared-wishlist-title">
  <div class="ffwinks-fullscreen__wishlist-header ffw-shared-wishlist__header">
    <div class="ffw-shared-wishlist__heading">
      <h1 id="ffw-shared-wishlist-title">Shared wishlist</h1>
      <p>This wishlist was shared with you.</p>
    </div>
    <p class="ffw-shared-wishlist__meta" id="ffw-shared-wishlist-count" aria-live="polite"></p>
  </div>

  <div class="ffw-shared-wishlist__status" id="ffw-shared-wishlist-status" role="status">Loading wishlist...</div>

  <div class="ffwinks-soul-list" id="ffw-shared-wishlist-list">
    <div id="ffw-shared-wishlist-empty" class="ffwinks-soul-addall-wrapper" style="display: none; pointer-events: none;">
      <div class="ffwinks-img-btn-wrap">
        <img src="{{ 'addall.svg' | asset_url }}" alt="" class="ffwinks-action-img ffwinks-action-img--invert">
        <span class="ffwinks-img-label">Wishlist is empty</span>
      </div>
    </div>
  </div>

  <div class="ffwinks-soul-addall-wrapper" id="ffw-shared-wishlist-add-all-wrapper" style="display: none;">
    <button class="ffwinks-soul-action-bottom" id="ffw-shared-wishlist-add-all" type="button">
      <div class="ffwinks-img-btn-wrap">
        <img src="{{ 'addall.svg' | asset_url }}" alt="" class="ffwinks-action-img ffwinks-action-img--invert">
        <span class="ffwinks-img-label">Add all to cart</span>
      </div>
    </button>
  </div>
</section>

{% stylesheet %}
  .ffw-shared-wishlist.ffwinks-fullscreen {
    z-index: 550;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  body.ffwinks-open .ffw-shared-wishlist,
  body.ffwinks-body-lock .ffw-shared-wishlist {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .ffw-shared-wishlist .ffw-shared-wishlist__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  .ffw-shared-wishlist__heading {
    display: grid;
    gap: 4px;
    pointer-events: none;
  }

  .ffw-shared-wishlist__heading h1,
  .ffw-shared-wishlist__heading p,
  .ffw-shared-wishlist__meta,
  .ffw-shared-wishlist__status {
    margin: 0;
    font-family: 'Montserrat', Arial, sans-serif;
    letter-spacing: 0;
  }

  .ffw-shared-wishlist__heading h1 {
    font-size: var(--soul-font-subtotal, 10px);
    line-height: 1.4;
    font-weight: 600;
    color: #222;
    text-transform: none;
  }

  .ffw-shared-wishlist__heading p,
  .ffw-shared-wishlist__meta,
  .ffw-shared-wishlist__status {
    font-size: var(--soul-font-label, 9px);
    line-height: 1.5;
    color: #777;
  }

  .ffw-shared-wishlist__status {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  .ffw-shared-wishlist__status[hidden] {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ffw-shared-wishlist {
      --soul-img-h: 36vh;
      --soul-row-min-h: var(--soul-img-h);
      --soul-list-pb: 36svh;
      overscroll-behavior: contain;
    }

    .ffw-shared-wishlist .ffwinks-soul-details-box {
      padding-top: 40px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shared wishlist",
  "settings": []
}
{% endschema %}
