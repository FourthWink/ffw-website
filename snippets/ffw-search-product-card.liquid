{% # theme-check-disable ValidScopedCSSClass %}

{%- liquid
  assign primary_image = product.featured_image | default: product.featured_media.preview_image
  assign hover_image = blank
  assign size_names = product.metafields.shopify.size.value | map: 'label' | join: ', '
  assign color_names = product.metafields.shopify.color-pattern.value | map: 'label' | join: ', '

  for image in product.images
    if primary_image == blank or image.id != primary_image.id
      assign hover_image = image
      break
    endif
  endfor

  for option in product.options_with_values
    assign option_handle = option.name | handleize
    if size_names == blank and option_handle contains 'size'
      assign size_names = option.values | join: ', '
    endif
    if color_names == blank and option_handle contains 'color'
      assign color_names = option.values | join: ', '
    endif
  endfor
-%}

<a
  class="ffw-shop-product"
  href="{{ product.url }}"
  aria-label="{{ product.title | escape }}"
  data-product-id="{{ product.id }}"
  data-product-type="{{ product.type | handle }}"
  data-product-tags="{% for tag in product.tags %}{{ tag | handleize }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  data-product-price="{{ product.price }}"
  data-product-available="{{ product.available }}"
  data-available-sizes="{{ size_names | escape }}"
  data-available-colors="{{ color_names | escape }}"
>
  <div class="ffw-shop-product-image{% if hover_image != blank %} ffw-shop-product-image--has-hover{% endif %}">
    {%- if primary_image -%}
      <div class="ffw-shop-product-image-stack">
        <img
          src="{{ primary_image | image_url: width: 600 }}"
          alt="{{ primary_image.alt | escape | default: product.title }}"
          loading="lazy"
          width="600"
          height="{{ 600 | divided_by: primary_image.aspect_ratio | round }}"
          class="ffw-shop-product-image-primary"
        >
        {%- if hover_image != blank -%}
          <img
            src="{{ hover_image | image_url: width: 600 }}"
            alt=""
            aria-hidden="true"
            loading="lazy"
            width="600"
            height="{{ 600 | divided_by: hover_image.aspect_ratio | round }}"
            class="ffw-shop-product-image-secondary"
          >
        {%- endif -%}
      </div>
    {%- else -%}
      <img src="{{ 'product.svg' | asset_url }}" alt="{{ product.title | escape }}" width="600" height="600">
    {%- endif -%}
  </div>

  <div class="ffw-shop-product-info">
    <div class="ffw-shop-text-group">
      <p class="ffw-shop-product-name">{{ product.title }}</p>
      <p class="ffw-shop-product-price">
        {%- if product.compare_at_price > product.price -%}
          <span class="ffw-price-compare">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        {{ product.price | money }}
      </p>
    </div>

    <button
      class="ffw-shop-product-icon ffw-wishlist-btn shop-product-icon"
      data-ffwinks-sparkle
      aria-label="Add {{ product.title | escape }} to wishlist"
      data-variant-id="{{ product.first_available_variant.id | default: product.variants.first.id | default: product.id }}"
      data-title="{{ product.title | escape }}"
      data-price="{{ product.price | divided_by: 100.0 }}"
      data-price-formatted="{{ product.price | money }}"
      data-image="{{ product.featured_media | image_url: width: 300 }}"
      data-url="{{ product.url }}"
      data-available-sizes="{{ size_names | escape }}"
      data-available-colors="{{ color_names | escape }}"
      data-svg-empty="{{ 'sparkle.svg' | asset_url }}"
      data-svg-filled="{{ 'sparkle-icon.svg' | asset_url }}"
      type="button"
    >
      <img src="{{ 'sparkle.svg' | asset_url }}" alt="Wishlist" width="14" height="14">
    </button>
  </div>
</a>

{% # theme-check-enable ValidScopedCSSClass %}
