{% comment %}
  Fourth Wink product floating Add to Cart.

  Rendered from templates/product.json through the custom-liquid section for
  theme-editor compatibility. This snippet owns markup/styles only; the global
  cart overlay section owns .floating-atc-btn clicks.
{% endcomment %}

<div id="floating-atc-slot-{{ section.id }}" class="floating-atc-slot">
  <div class="floating-atc">
    <button type="button" class="ffwinks-soul-action-bottom floating-atc-btn">
      <div class="ffwinks-img-btn-wrap">
        <img src="{{ 'soul.svg' | asset_url }}" alt="Star" class="ffwinks-action-img inverted-star">
        <span class="ffwinks-img-label floating-atc-text" data-shimmer-text="Add to cart">Add to cart</span>
      </div>
    </button>
  </div>
</div>

<style>
  button[name=add],
  .product-form__submit {
    position: absolute !important;
    left: -9999px !important;
    visibility: hidden;
  }

  .floating-atc {
    position: fixed;
    top: 50vh;
    left: 50vw;
    transform: translate(-50%, -50%);
    z-index: 999999;
  }

  .floating-atc-btn,
  .ffwinks-img-btn-wrap {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    cursor: pointer;
  }

  .inverted-star {
    filter: invert(1);
    mix-blend-mode: normal;
  }

  .floating-atc .ffwinks-img-label {
    color: #666666;
    transition: color 0.3s ease;
    font-weight: 700 !important;
  }

  .floating-atc-text {
    color: #666666;
    font-weight: 700 !important;
  }

  body.cart-overlay-open .floating-atc {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .floating-atc-btn:hover .ffwinks-img-label,
  .floating-atc-btn:hover .floating-atc-text {
    color: #000 !important;
    font-weight: 700 !important;
  }

  @media (min-width: 990px) {
    .floating-atc .floating-atc-text::after {
      content: attr(data-shimmer-text);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 1em;
      line-height: 1em;
      transform: translateY(-50%);
      z-index: 1;
      opacity: 0;
      pointer-events: none;
    }

    .floating-atc .floating-atc-text::after {
      color: #d0d0d0;
      -webkit-text-fill-color: #d0d0d0;
      filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.8));
    }

    .floating-atc.ffw-atc-shimmer-active .floating-atc-text::after {
      animation: ffw-atc-text-shimmer 1.35s linear 4;
    }

    @keyframes ffw-atc-text-shimmer {
      0% {
        clip-path: inset(0 100% 0 0);
        opacity: 0;
      }
      12% {
        clip-path: inset(0 70% 0 0);
        opacity: 1;
      }
      50% { clip-path: inset(0 35% 0 35%); }
      88% {
        clip-path: inset(0 0 0 70%);
        opacity: 1;
      }
      100% {
        clip-path: inset(0 0 0 100%);
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .floating-atc .floating-atc-text::after {
        animation: none;
        display: none;
      }
    }
  }

  @media(max-width:900px) {
    .floating-atc {
      display: flex;
      justify-content: center;
    }
  }
</style>

<script>
  (function() {
    function startDesktopAtcShimmer() {
      if (!window.matchMedia('(min-width: 990px)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var floatingAtc = document.querySelector('.floating-atc');
      if (!floatingAtc || floatingAtc.dataset.ffwShimmerStarted) return;

      floatingAtc.dataset.ffwShimmerStarted = 'true';
      window.setTimeout(function() {
        floatingAtc.classList.add('ffw-atc-shimmer-active');
        window.setTimeout(function() {
          floatingAtc.classList.remove('ffw-atc-shimmer-active');
        }, 5400);
      }, 900);
    }

    if (document.readyState === 'complete') {
      startDesktopAtcShimmer();
    } else {
      window.addEventListener('load', startDesktopAtcShimmer, { once: true });
    }
  })();
</script>
