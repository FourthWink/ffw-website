{% comment %}
  Fourth Wink product floating Add to Cart.

  Rendered from templates/product.json through the custom-liquid section for
  theme-editor compatibility. This snippet owns markup/styles only; the global
  cart overlay section owns .floating-atc-btn clicks.
{% endcomment %}

<div id="floating-atc-slot-{{ section.id }}" class="floating-atc-slot">
  <div class="floating-atc">
    <button type="button" class="ffwinks-soul-action-bottom floating-atc-btn">
      <div class="ffwinks-img-btn-wrap">
        <img src="{{ 'soul.svg' | asset_url }}" alt="Star" class="ffwinks-action-img inverted-star">
        <span class="ffwinks-img-label floating-atc-text">Add to cart</span>
      </div>
    </button>
  </div>
</div>

<style>
  button[name=add],
  .product-form__submit {
    position: absolute !important;
    left: -9999px !important;
    visibility: hidden;
  }

  .floating-atc {
    position: fixed;
    top: 50vh;
    left: 50vw;
    transform: translate(-50%, -50%);
    z-index: 999999;
  }

  .floating-atc-btn,
  .ffwinks-img-btn-wrap {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    cursor: pointer;
  }

  .inverted-star {
    filter: invert(1);
    mix-blend-mode: normal;
  }

  .floating-atc .ffwinks-img-label {
    color: #666666;
    transition: color 0.3s ease;
    font-weight: 700 !important;
  }

  .floating-atc-text {
    color: #666666;
    font-weight: 700 !important;
  }

  body.cart-overlay-open .floating-atc {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .floating-atc-btn:hover .ffwinks-img-label,
  .floating-atc-btn:hover .floating-atc-text {
    color: #000 !important;
    font-weight: 700 !important;
  }

  @media (min-width: 990px) {
    .floating-atc .floating-atc-text {
      --ffw-atc-shimmer-base: #666666;
      --ffw-atc-shimmer-highlight: #000000;
      --ffw-atc-shimmer-spread: 22px;
      color: transparent !important;
      background-image:
        linear-gradient(
          90deg,
          transparent calc(50% - var(--ffw-atc-shimmer-spread)),
          var(--ffw-atc-shimmer-highlight),
          transparent calc(50% + var(--ffw-atc-shimmer-spread))
        ),
        linear-gradient(var(--ffw-atc-shimmer-base), var(--ffw-atc-shimmer-base));
      background-position: 100% center, 0 0;
      background-repeat: no-repeat, padding-box;
      background-size: 250% 100%, auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: ffw-atc-text-shimmer 1.15s linear 0.45s 4;
    }

    .floating-atc-btn:is(:hover, :focus-visible, :active) .floating-atc-text {
      --ffw-atc-shimmer-base: #000000;
      --ffw-atc-shimmer-highlight: #000000;
    }

    @keyframes ffw-atc-text-shimmer {
      from { background-position: 100% center, 0 0; }
      to { background-position: 0% center, 0 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .floating-atc .floating-atc-text {
        animation: none;
      }
    }
  }

  @media(max-width:900px) {
    .floating-atc {
      display: flex;
      justify-content: center;
    }
  }
</style>
