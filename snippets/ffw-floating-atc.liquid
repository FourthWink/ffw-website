{% comment %}
  Fourth Wink product floating Add to Cart.

  Rendered from templates/product.json through the custom-liquid section for
  theme-editor compatibility. This snippet owns markup/styles only; the global
  cart overlay section owns .floating-atc-btn clicks.
{% endcomment %}

<div id="floating-atc-slot-{{ section.id }}" class="floating-atc-slot">
  <div class="floating-atc">
    <button type="button" class="ffwinks-soul-action-bottom floating-atc-btn">
      <div class="ffwinks-img-btn-wrap">
        <img src="{{ 'soul.svg' | asset_url }}" alt="Star" class="ffwinks-action-img inverted-star">
        <span class="ffwinks-img-label floating-atc-text" data-shimmer-text="Add to cart">Add to cart</span>
      </div>
    </button>
  </div>
</div>

<style>
  button[name=add],
  .product-form__submit {
    position: absolute !important;
    left: -9999px !important;
    visibility: hidden;
  }

  .floating-atc {
    position: fixed;
    top: 50vh;
    left: 50vw;
    transform: translate(-50%, -50%);
    z-index: 999999;
  }

  .floating-atc-btn,
  .ffwinks-img-btn-wrap {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    cursor: pointer;
  }

  .inverted-star {
    filter: invert(1);
    mix-blend-mode: normal;
  }

  .floating-atc .ffwinks-img-label {
    color: #000000;
    transition: color 0.3s ease;
    font-weight: 700 !important;
  }

  .floating-atc-text {
    color: #000000;
    font-weight: 700 !important;
  }

  body.cart-overlay-open .floating-atc {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .floating-atc-btn:hover .ffwinks-img-label,
  .floating-atc-btn:hover .floating-atc-text {
    color: #000 !important;
    font-weight: 700 !important;
  }

  @media (min-width: 990px) {
    .floating-atc .floating-atc-text::after {
      content: attr(data-shimmer-text);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 1em;
      line-height: 1em;
      transform: translateY(-50%);
      z-index: 1;
      color: rgba(255, 255, 255, 0.85);
      -webkit-text-fill-color: rgba(255, 255, 255, 0.85);
      filter: blur(0.6px) drop-shadow(0 0 1px rgba(255, 255, 255, 0.65));
      animation: ffw-atc-text-shimmer 4s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes ffw-atc-text-shimmer {
      0% {
        clip-path: polygon(-45% 0, -15% 0, -45% 100%, -75% 100%);
        opacity: 0;
      }
      4% {
        opacity: 1;
      }
      24% {
        opacity: 1;
      }
      28% {
        clip-path: polygon(175% 0, 205% 0, 175% 100%, 145% 100%);
        opacity: 0;
      }
      100% { opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .floating-atc .floating-atc-text::after {
        animation: none;
        display: none;
      }
    }
  }

  @media(max-width:900px) {
    .floating-atc {
      display: flex;
      justify-content: center;
    }
  }
</style>
