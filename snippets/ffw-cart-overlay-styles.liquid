{% comment %}
  Fourth Wink legacy cart overlay styles.

  JavaScript remains in sections/custom-liquid.liquid while the legacy cart
  overlay is being separated from the generic Custom Liquid section wrapper.
{% endcomment %}

<style>
  :root {
    --cart-header-h: 54px; 
    --cart-pad-x: 30px; 
    --cart-img-h: clamp(150px, calc(50vh - var(--cart-header-h)), 800px);
    --cart-box-curve-gap: clamp(0px, calc((100vh - 800px) * 0.05), 10px);
    --cart-box-top-trim: calc(var(--cart-img-h) * 0.10);
    --cart-image-height: calc(85% - (var(--cart-img-h) * 0.0425));
    --cart-items-padding-bottom: 32vh;
  }

  /* --- Huge Screens (1800px+) --- */
  @media screen and (min-width: 1800px) {
    :root {
      --cart-img-h: clamp(150px, calc(50vh - var(--cart-header-h)), 800px);
    }
  }

  /* 1. Global Reset - Set to 500 so it sits neatly UNDER the Header (z-index 600) */
  .cart-overlay { display: none; position: fixed; inset: 0; z-index: 500; font-family: var(--cart-font); }
  .cart-overlay.is-open { display: block; }
  .cart-overlay__backdrop { position: absolute; inset: 0; background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(4px); animation: backdropIn 0.25s ease forwards; }

  @keyframes backdropIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes backdropOut { from { opacity: 1; } to { opacity: 0; } }
  @keyframes drawerIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @keyframes drawerOut { from { transform: translateX(0); } to { transform: translateX(100%); } }

  /* 2. Desktop-Only CSS (Side Drawer) */
  @media screen and (min-width: 750px) {
    .mobile-only { display: none !important; }
    
    .cart-overlay__drawer {
      position: absolute; top: 0; right: 0; bottom: 0; width: 50vw;
      background: #ffffff; display: flex; flex-direction: column;
      border-left: none;
      animation: drawerIn 0.3s cubic-bezier(0.32, 0.72, 0, 1) forwards;
    }
    .cart-overlay.is-closing .cart-overlay__drawer { animation: drawerOut 0.25s cubic-bezier(0.32, 0.72, 0, 1) forwards; }
    .cart-overlay.is-closing .cart-overlay__backdrop { animation: backdropOut 0.25s ease forwards; }

    .cart-overlay__header { display: flex; justify-content: flex-end; align-items: center; padding: 0 var(--cart-pad-x); height: var(--cart-header-h); flex-shrink: 0; }
    .cart-overlay__close { background: none; border: none; cursor: pointer; padding: 10px; display: flex; align-items: center; justify-content: center; transition: opacity 0.2s; }
    .cart-overlay__close:hover { opacity: 0.6; }

    .cart-overlay__floating-wrapper {
      position: fixed;
      top: 50%;
      left: 50vw;
      transform: translate(-50%, -50%);
      z-index: 505;
      transition: top 0.15s ease-out;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      mix-blend-mode: normal;
      view-transition-name: none !important;
    }
    body.cart-overlay-open .cart-overlay__floating-wrapper { 
      opacity: 1 !important; 
      visibility: visible !important; 
      pointer-events: auto !important; 
    }
    .ffwinks-img-btn-wrap { color: #ffffff; }
    .cart-overlay__floating-svg { filter: brightness(0); }

    .cart-overlay__items { 
      flex: 1 1 auto; 
      overflow-y: auto; 
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      scroll-snap-type: y mandatory;
      padding: 0 var(--cart-pad-x) 0 var(--cart-pad-x); 
      scrollbar-width: none; 
      -ms-overflow-style: none;
      padding-bottom: var(--cart-items-padding-bottom);
    }
    .cart-overlay__items::-webkit-scrollbar { display: none; }

    .cart-item { position: relative; display: flex; flex-direction: column; width: calc(100% + var(--cart-pad-x)); margin-left: calc(-1 * var(--cart-pad-x)); margin-bottom: 40px; scroll-snap-align: start; scroll-snap-stop: normal;
      animation: itemFadeIn 0.3s ease forwards; opacity: 0; }
    .cart-item__remove-btn-desktop { position: absolute; top: calc(var(--cart-box-top-trim) + 12px); left: 6px; background: transparent; border: none; font-size: 18px; color: #666666; cursor: pointer; z-index: 5; padding: 0; line-height: 1; font-family: 'Montserrat', Arial, sans-serif !important; font-weight: 400; transition: color 0.2s, font-weight 0.1s; }
    .cart-item__remove-btn-desktop:hover { color: #000; }
    
    .cart-item__left { width: calc(100% - 24px); height: calc(var(--cart-img-h) - var(--cart-box-curve-gap) - var(--cart-box-top-trim)); margin-top: var(--cart-box-top-trim); margin-left: 6px; margin-bottom: var(--cart-box-curve-gap); background: #f4f4f4; border-radius: var(--soul-img-radius-pill, 70px); display: flex; justify-content: center; align-items: center; overflow: hidden; transform: translateZ(0); filter: none; opacity: 1; }
    .cart-item__left img { width: calc(50% + 12px); height: var(--cart-image-height); max-width: 100%; max-height: var(--cart-image-height); object-fit: contain; object-position: center; pointer-events: none; transition: none; will-change: auto; filter: none; opacity: 1; }
    
    .cart-item__right { display: flex; flex-direction: column; width: calc(100% - 28px); margin-left: 28px; padding: 84px 10px 10px 20px; gap: 16px; font-family: 'Montserrat', Arial, sans-serif !important; font-size: 10px; color: #000000; }
    .cart-item__row { display: flex; justify-content: space-between; align-items: center; font-size: 10px; margin-bottom: 10px; }
    .cart-item__title { font-weight: 700; }
    .cart-item__price { color: #000000; font-size: 9px; font-weight: 400; }
    .cart-item__variant-row, .cart-item__qty-container { display: flex; justify-content: flex-start; align-items: center; }
    .cart-item__variant-label, .cart-item__qty-label { width: 100px; color: #000000; font-weight: 400; }
    .cart-item__variant-value { color: #000000; font-weight: 700; }
    .cart-item__qty { display: flex; align-items: center; gap: 20px; }
    .cart-item__qty-btn { background: none; border: none; cursor: pointer; font-size: 10px; color: #000000; padding: 0; line-height: 1; }
    .cart-item__qty-num { min-width: 12px; text-align: center; font-weight: 700; }

    .cart-overlay__text {
      color: #000000 !important;
      font-weight: 700 !important;
    }
    .cart-overlay__text::after {
      content: attr(data-shimmer-text);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 1em;
      line-height: 1em;
      transform: translateY(-50%);
      z-index: 1;
      color: rgba(255, 255, 255, 0.85);
      -webkit-text-fill-color: rgba(255, 255, 255, 0.85);
      filter: blur(0.6px) drop-shadow(0 0 1px rgba(255, 255, 255, 0.65));
      animation: ffw-cart-checkout-shimmer 4s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes ffw-cart-checkout-shimmer {
      0% {
        clip-path: polygon(-45% 0, -15% 0, -45% 100%, -75% 100%);
        opacity: 0;
      }
      4%, 24% { opacity: 1; }
      28% {
        clip-path: polygon(175% 0, 205% 0, 175% 100%, 145% 100%);
        opacity: 0;
      }
      100% { opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cart-overlay__text::after {
        animation: none;
        display: none;
      }
    }

    .cart-overlay__footer { flex-shrink: 0; background: rgba(255, 255, 255, 0.82); padding: 30px 40px; border-radius: 40px 40px 0 0; margin: 0 10px; -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: 0 -16px 30px rgba(255, 255, 255, 0.88), inset 0 1px 14px rgba(0, 0, 0, 0.025); }
    .cart-overlay__subtotal-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; font-size: 10px; }
    .cart-overlay__subtotal-label { color: var(--cart-text-color); }
    .cart-overlay__subtotal-value { color: var(--cart-text-color); font-size: 9px; font-weight: 700; }
    .cart-overlay__tax-note { font-size: 10px; color: var(--cart-muted-color); margin: 0; }
  }

  /* 3. Mobile-Only CSS (Soul Style) */
  @media screen and (max-width: 749px) {
    .desktop-only { display: none !important; }
    
    .mobile-ffwinks-cart {
      position: fixed; inset: 0; width: 100vw; height: 100dvh;
      background: #fff; z-index: 501;
      animation: drawerIn 0.3s cubic-bezier(0.32, 0.72, 0, 1) forwards;
    }
    .cart-overlay.is-closing .mobile-ffwinks-cart { animation: drawerOut 0.25s cubic-bezier(0.32, 0.72, 0, 1) forwards; }
    .cart-overlay.is-closing .cart-overlay__backdrop { animation: backdropOut 0.25s ease forwards; }

    .mobile-scrollable-area {
      position: absolute; inset: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-top: var(--header-overlay-offset, 60px);
      padding-bottom: 7svh; 
      z-index: 1;
    }
    .mobile-scrollable-area::-webkit-scrollbar { display: none; }

    .ffwinks-soul-list { 
      padding: var(--soul-list-pt, 40px) var(--ffwinks-master-spacing, 30px) 0 0;
    }

    .ffwinks-soul-subtotal-wrapper {
      position: fixed; bottom: 0; left: 0; right: 0;
      z-index: 504; 
      text-align: right; width: 100%;
      padding-right: 30px;
      padding-top: var(--soul-subtotal-pt-cart, 48px);
      padding-bottom: 20px;
      background: linear-gradient(to top, rgba(255,255,255,1) 35%, rgba(255,255,255,0) 100%);
      box-sizing: border-box;
      pointer-events: none;
    }
    .ffwinks-soul-subtotal-row,
    .ffwinks-soul-subtotal-info { pointer-events: auto; }
    .ffwinks-soul-subtotal-row { display: flex; justify-content: flex-end; gap: 38px; margin-bottom: 8px; }
    .ffwinks-soul-subtotal-label { font-size: 10px; color: #000000; font-weight: 700; }
    .ffwinks-soul-subtotal-price { font-size: 9px; color: #000000; font-weight: 400; }
    .ffwinks-soul-subtotal-info { font-size: 10px; color: #BBBBBB; margin: 0; text-align: right; }

    .ffwinks-soul-checkout-wrapper {
      position: fixed !important; left: 50% !important;
      top: 50% !important;
      transform: translate3d(-50%, -50%, 0) !important;
      z-index: 505;
      pointer-events: none;
      display: flex; justify-content: center;
      align-items: center;
    }
    .ffwinks-soul-action-bottom { pointer-events: auto; display: block; text-decoration: none; background: transparent; border: none; padding: 0; cursor: pointer; }
    .ffwinks-img-btn-wrap { position: relative; display: inline-block; line-height: 0; color: #666666; }
    .ffwinks-action-img { width: 150px; height: auto; display: block; }
    .ffwinks-img-label { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 10px; color: #666666; pointer-events: none; font-weight: 400; font-family: 'Montserrat', Arial, sans-serif !important; transition: color 0.3s ease; }
    .ffwinks-soul-action-bottom:hover .ffwinks-img-label { color: #000; }
    .cart-overlay__floating-btn .ffwinks-img-label,
    #cart-checkout-wrapper-mobile .ffwinks-img-label {
      color: #000 !important;
      font-weight: 700 !important;
    }

    /* Mobile close button */
    .mobile-cart-close-btn {
      position: fixed; top: 50px;
      right: 16px;
      z-index: 506;
      background: rgba(255,255,255,0.9);
      border: 1px solid #e0e0e0;
      border-radius: 50%;
      width: 20px;
      height: 20px;
      display: flex; align-items: center;
      justify-content: center;
      cursor: pointer;
      backdrop-filter: blur(4px);
      transition: background 0.2s, opacity 0.2s;
    }
    .mobile-cart-close-btn:hover { background: #f0f0f0; }

    .mobile-star { filter: brightness(0); }

    /* Gradients to match homepage fog */
    .mobile-gradient-top { position: fixed; top: 0; left: 0; width: 100%; height: 40px; z-index: 5; pointer-events: none; background: linear-gradient(to bottom, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 100%); }
    .mobile-gradient-bottom { position: fixed; bottom: 0; left: 0; width: 100%; height: 15px; z-index: 5; pointer-events: none; background: linear-gradient(to top, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 100%); }
    
    .mobile-item {
      animation: itemFadeIn 0.3s ease forwards; opacity: 0;
    }
  }

  @keyframes itemFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  html:has(body.cart-overlay-open),
  body.cart-overlay-open {
    overflow: hidden !important;
    overscroll-behavior: none;
  }

  /* Hide product page sparkle AND Add-to-Cart star when cart is open */
  body.cart-overlay-open #ffwinks-product-sparkle,
  body.cart-overlay-open .product-sparkle-icon,
  body.cart-overlay-open .floating-atc-btn,
  body.cart-overlay-open .floating-atc-wrapper {
    opacity: 0 !important; visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Nuke ALL stars AND sparkles off the screen the second the Lips transition starts */
  body:has(#ffw-checkout-transition.is-active) #ffwinks-product-sparkle,
  body:has(#ffw-checkout-transition.is-active) .product-sparkle-icon,
  body:has(#ffw-checkout-transition.is-active) .floating-atc-btn,
  body:has(#ffw-checkout-transition.is-active) .cart-overlay__floating-wrapper,
  body:has(#ffw-checkout-transition.is-active) .ffwinks-soul-checkout-wrapper {
    opacity: 0 !important; visibility: hidden !important;
    pointer-events: none !important;
  }
  .cart-overlay__loading, .ffwinks-empty-msg { text-align: center; color: #BBBBBB; font-size: 10px; margin-top: 50px; font-family: 'Montserrat', Arial, sans-serif !important; }
</style>
